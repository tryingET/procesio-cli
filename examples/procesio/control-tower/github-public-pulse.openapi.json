{
  "openapi": "3.0.3",
  "info": {
    "title": "CLI Control Tower - GitHub Public Pulse",
    "version": "1.0.0",
    "description": "Minimal read-only GitHub connector used by the PROCESIO Control Tower founder briefing. It exposes only public repository and commit metadata and contains no write operation or authentication secret."
  },
  "servers": [
    {
      "url": "https://api.github.com"
    }
  ],
  "paths": {
    "/repos/{owner}/{repo}": {
      "get": {
        "operationId": "GetRepository",
        "summary": "Get public repository pulse",
        "parameters": [
          {
            "name": "owner",
            "in": "path",
            "required": true,
            "schema": {"type": "string"}
          },
          {
            "name": "repo",
            "in": "path",
            "required": true,
            "schema": {"type": "string"}
          },
          {
            "name": "Accept",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "application/vnd.github+json"
            }
          },
          {
            "name": "X-GitHub-Api-Version",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "2022-11-28"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Repository metadata",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/RepositoryPulse"}
              }
            }
          },
          "403": {
            "description": "Public rate limit or policy refusal",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/GitHubError"}
              }
            }
          },
          "404": {
            "description": "Repository not found",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/GitHubError"}
              }
            }
          }
        }
      }
    },
    "/repos/{owner}/{repo}/commits/{ref}": {
      "get": {
        "operationId": "GetCommit",
        "summary": "Get one public commit",
        "parameters": [
          {
            "name": "owner",
            "in": "path",
            "required": true,
            "schema": {"type": "string"}
          },
          {
            "name": "repo",
            "in": "path",
            "required": true,
            "schema": {"type": "string"}
          },
          {
            "name": "ref",
            "in": "path",
            "required": true,
            "schema": {"type": "string", "default": "main"}
          },
          {
            "name": "Accept",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "application/vnd.github+json"
            }
          },
          {
            "name": "X-GitHub-Api-Version",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "2022-11-28"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Commit metadata",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/CommitPulse"}
              }
            }
          },
          "403": {
            "description": "Public rate limit or policy refusal",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/GitHubError"}
              }
            }
          },
          "404": {
            "description": "Commit or repository not found",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/GitHubError"}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RepositoryPulse": {
        "type": "object",
        "properties": {
          "id": {"type": "integer", "format": "int64"},
          "name": {"type": "string"},
          "full_name": {"type": "string"},
          "html_url": {"type": "string", "format": "uri"},
          "description": {"type": "string", "nullable": true},
          "default_branch": {"type": "string"},
          "private": {"type": "boolean"},
          "fork": {"type": "boolean"},
          "stargazers_count": {"type": "integer"},
          "forks_count": {"type": "integer"},
          "open_issues_count": {"type": "integer"},
          "watchers_count": {"type": "integer"},
          "language": {"type": "string", "nullable": true},
          "created_at": {"type": "string", "format": "date-time"},
          "updated_at": {"type": "string", "format": "date-time"},
          "pushed_at": {"type": "string", "format": "date-time"}
        }
      },
      "CommitAuthor": {
        "type": "object",
        "properties": {
          "name": {"type": "string", "nullable": true},
          "email": {"type": "string", "nullable": true},
          "date": {"type": "string", "format": "date-time", "nullable": true}
        }
      },
      "CommitDetail": {
        "type": "object",
        "properties": {
          "message": {"type": "string"},
          "author": {"$ref": "#/components/schemas/CommitAuthor"},
          "committer": {"$ref": "#/components/schemas/CommitAuthor"}
        }
      },
      "CommitPulse": {
        "type": "object",
        "properties": {
          "sha": {"type": "string"},
          "html_url": {"type": "string", "format": "uri"},
          "commit": {"$ref": "#/components/schemas/CommitDetail"}
        }
      },
      "GitHubError": {
        "type": "object",
        "properties": {
          "message": {"type": "string"},
          "documentation_url": {"type": "string", "nullable": true},
          "status": {"type": "string", "nullable": true}
        }
      }
    }
  }
}
